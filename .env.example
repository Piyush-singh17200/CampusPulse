# -----------------------------------------------------------------------------
# CampusPulse environment contract
# Copy this file to .env.local and replace placeholders for local development.
# Never commit .env.local or any real secret.
# -----------------------------------------------------------------------------

# PostgreSQL connection used by the Next.js application.
# In production, use the pooled connection string when the provider offers one.
# This project's Docker database uses host port 5434 because native PostgreSQL
# or another local Docker project may already own ports 5432 and 5433.
DATABASE_URL="postgresql://campuspulse:campuspulse@localhost:5434/campuspulse?schema=public"

# Direct PostgreSQL connection used by the Prisma CLI (migrations, introspection).
# Locally this is the same as DATABASE_URL. In production, use the provider's
# direct/non-pooled connection string.
DIRECT_URL="postgresql://campuspulse:campuspulse@localhost:5434/campuspulse?schema=public"

# Isolated database used only by the automated test suite. The name must be
# exactly campuspulse_test; tests refuse to run against any other database.
TEST_DATABASE_URL="postgresql://campuspulse:campuspulse@localhost:5434/campuspulse_test?schema=public"

# Optional connection-pool tuning. Defaults are suitable for local development.
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
# DATABASE_SSL="true"             # Enable for a TLS-required hosted database.
# DATABASE_LOG_QUERIES="false"    # Do not enable in production.

# Public origin used for metadata and absolute URLs. This value is exposed to
# the browser by design. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Authentication and security
# -----------------------------------------------------------------------------
# Required. Generate a unique 32+ byte random value for each environment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public origin used by Better Auth. Must match NEXT_PUBLIC_APP_URL.
# Production must use an https:// URL so auth cookies are Secure end to end.
BETTER_AUTH_URL="http://localhost:3000"

# Optional separate key for HMAC-ing rate-limit lookup keys. If omitted,
# BETTER_AUTH_SECRET is used. Use a different value in production if desired.
# RATE_LIMIT_SECRET="replace-with-a-separate-32-byte-random-secret"

# SMTP is optional locally. When false, development-only reset links may be
# returned to the local browser; production never returns a reset token.
# Production password recovery requires EMAIL_ENABLED=true and the SMTP values
# below. Use provider-specific app passwords or credentials from a secret manager.
EMAIL_ENABLED="false"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="CampusPulse <no-reply@example.com>"
