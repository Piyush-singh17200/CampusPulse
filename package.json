{
  "name": "campuspulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts --confirm-development-seed",
    "db:health": "tsx scripts/check-db.ts",
    "db:studio": "prisma studio",
    "auth:bootstrap-super-admin": "tsx --conditions=react-server scripts/bootstrap-super-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.18",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-auth": "^1.7.18",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "24.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
